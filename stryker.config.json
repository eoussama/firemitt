{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node node_modules/vitest/vitest.mjs run --bail=1"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/**/*.ts",
    "!src/**/index.ts",
    "!src/types/**",
    "!src/interfaces/**"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "timeoutMS": 10000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": "50%"
}
